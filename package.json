{
  "name": "tiktok-shop-creator",
  "version": "1.0.0",
  "description": "TikTok Shop 达人抓取工具 - 专为 TikTok Shop 卖家打造的联盟达人数据采集桌面应用，一键抓取达人广场数据，支持多账号并发、CSV/Excel 导出、达人筛选、选品分析。TikTok Shop affiliate creator scraper desktop app for sellers.",
  "main": "main.js",
  "author": "1Milkdeliver <https://github.com/1Milkdeliver>",
  "homepage": "https://github.com/1Milkdeliver/tiktok-shop-creator",
  "license": "MIT",
  "dependencies": {
    "puppeteer-core": "^24.0.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tiktok.creator.scraper",
    "productName": "TikTok达人抓取",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "lib/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TikTok达人抓取.exe"
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-zip": "electron-builder --win zip"
  }
}
